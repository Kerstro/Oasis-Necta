---
import '../styles/global.css';
import '../styles/contract-overrides.css';

const whatsapp = '254726897456';
const wa = (message) => `https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`;
const buy = [
  ['Raw honey', 'KES 550', 'per kg'], ['Beeswax', 'KES 500', 'per kg'], ['Propolis', 'KES 800', 'per kg'],
  ['Bee venom', 'KES 1,500', 'per gram'], ['Bee pollen', 'KES 1,000', 'per kg'],
];
const steps = [['01', 'Produce', 'You keep your hives and harvest.'], ['02', 'Collect', 'We collect your produce.'], ['03', 'Check', 'We check the quality.'], ['04', 'Pay', 'You get paid.']];
const catalog = [
  { name: 'Hives', items: [['Langstroth hive, deep super', 5500], ['Langstroth hive, standard', 4800], ['Kenya top bar hive', 4500]] },
  { name: 'Protective gear', items: [['Beesuit', 4000], ['Gloves', 500]] },
  { name: 'Tools', items: [['Smoker (medical)', 2500], ['Stainless smoker (imported)', 3500], ['Hive tool', 500], ['Bee brush', 500], ['Uncapping fork', 500], ['Hive knife', 200]] },
  { name: 'Honey processing', items: [['Double sieve', 3500], ['Conical sieve', 1500], ['Plastic settling tank, 20 litre', 2000], ['Stainless settling tank, 50 litre', 27000], ['Stainless settling tank, 100 litre', 35000], ['Honey press', 35000], ['Honey warmer, 10 kg', 90500], ['Honey extractor, plastic, 2/4 frames', 22000], ['Honey extractor, stainless, 2/4 frames', 35000], ['Honey extractor, stainless, 3/6 frames', 45000]] },
  { name: 'Optional equipment', items: [['Propolis collector', 2000], ['Pollen collector', 2500], ['Royal jelly harvesting kit', 4000], ['Bee venom collector (manual)', 60000], ['Bee venom machine (electric)', 85000], ['Hive stand (metal)', 1200], ['Plastic queen excluder', 800], ['Wax smelter machine', 15000]] },
];
const gallery = [
  ['p/team-in-apiary.jpg', 'The Oasis Necta team in the apiary'], ['p/p (1).jpeg', 'Honey harvest'], ['p/p (2).jpeg', 'Oasis Necta field work'], ['p/p (3).jpeg', 'Beekeeping in the field'], ['p/p (4).jpeg', 'Working with hives'], ['p/p (5).jpeg', 'Honey production'], ['p/p (6).jpeg', 'Oasis Necta honey'], ['p/p (7).jpeg', 'Apiary visit'], ['p/p (8).jpeg', 'Beekeeping equipment'], ['p/p (9).jpeg', 'Field training'], ['p/p (10).jpeg', 'Community beekeeping'], ['p/p (11).jpeg', 'Honey and bee products'], ['p/p (12).jpeg', 'A day in the apiary'], ['p/p (13).jpeg', 'Oasis Necta work'], ['t/T (1).jpeg', 'Outdoor training'], ['t/T (2).jpeg', 'Training demonstration'], ['t/T (3).jpeg', 'Training session'], ['t/T (4).jpeg', 'Learning together'], ['t/T (5).jpeg', 'Hive training'], ['t/T (6).jpeg', 'Beekeeping support'],
];
const explore = [
  ['contract', 'Start here', 'Contract beekeeping', 'Buy your hives, get trained and build a dependable route to market.', '/images/cards/card-contract.jpg'],
  ['honey', 'Buy', 'Honey & bee products', 'Pure bee products from Oasis Necta. Ask us for sizes and prices.', '/images/cards/card-honey.jpg'],
  ['shop', 'Build a quote', 'Hives & equipment', 'Browse the catalog and send your quote to us on WhatsApp.', '/images/cards/card-hives.jpg'],
  ['about', 'Our story', 'About & team', 'Meet the people behind the work and see life in the apiary.', '/images/cards/card-about.jpg'],
  ['contact', 'Talk to us', 'Contact us', 'Call, WhatsApp or find us in City Square, Nairobi.', '/images/cards/card-contact.jpg'],
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Oasis Necta provides contract beekeeping, honey, hives, training, technical support and a ready market for Kenyan beekeepers in Nairobi and major county towns." />
    <meta name="keywords" content="beekeeping Kenya, contract beekeeping Nairobi, honey Kenya, Langstroth hives Kenya, Kenya top bar hives, beekeeping training" />
    <meta name="author" content="Oasis Necta Ltd" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#1d2c24" />
    <link rel="canonical" href="https://oasisnecta.onrender.com/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oasis Necta Ltd" />
    <meta property="og:title" content="Oasis Necta | Beekeeping that grows with you" />
    <meta property="og:description" content="Contract beekeeping, honey, hives, training and a ready market for Kenyan beekeepers." />
    <meta property="og:url" content="https://oasisnecta.onrender.com/" />
    <meta property="og:image" content="https://oasisnecta.onrender.com/images/hero-beehives.jpg" />
    <meta property="og:image:alt" content="Oasis Necta beehives in Kenya" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Oasis Necta | Beekeeping that grows with you" />
    <meta name="twitter:description" content="Contract beekeeping, honey, hives, training and a ready market for Kenyan beekeepers." />
    <meta name="twitter:image" content="https://oasisnecta.onrender.com/images/hero-beehives.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Oasis Necta Ltd',
      description: 'Contract beekeeping, honey, hives, training and technical support for Kenyan beekeepers.',
      url: 'https://oasisnecta.onrender.com/',
      telephone: '+254726897456',
      email: 'oasisnectaltd1@gmail.com',
      image: 'https://oasisnecta.onrender.com/images/hero-beehives.jpg',
      logo: 'https://oasisnecta.onrender.com/favicon.png',
      address: { '@type': 'PostalAddress', streetAddress: 'City Square', addressLocality: 'Nairobi', addressCountry: 'KE', postalCode: '00200' },
      areaServed: 'Kenya',
      sameAs: ['https://www.facebook.com/profile.php?id=61582195871911', 'https://www.tiktok.com/@oasisnecta'],
      contactPoint: { '@type': 'ContactPoint', telephone: '+254726897456', contactType: 'customer service', availableLanguage: ['English', 'Swahili'] },
    })}></script>
    <title>Oasis Necta | Contract Beekeeping, Honey & Hives in Kenya</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="#home" aria-label="Oasis Necta home">
          <img src="/images/logo.png" alt="" /><span>Oasis<br /><em>Necta</em></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b>Menu</b></button>
        <nav id="main-nav" aria-label="Primary navigation">
          <a href="#home">Home</a><a href="#contract">Contract beekeeping</a><a href="#honey">Honey</a><a href="#shop">Hives & equipment</a><a href="#about">About</a><a href="#contact">Contact</a>
        </nav>
        <a class="nav-cta" href={wa('Hello Oasis Necta, I want to start beekeeping')} target="_blank" rel="noreferrer">Chat on WhatsApp <span>↗</span></a>
      </div>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-photo"></div><div class="hero-shade"></div>
        <div class="container hero-inner">
          <p class="eyebrow light">Kenyan beekeeping, made practical</p>
          <h1>Start small.<br /><i>Grow fast.</i><br />Earn consistently.</h1>
          <p class="hero-copy">Buy your hives from Oasis Necta and we train you, support you, deliver to major county towns and buy your honey and bee products.</p>
          <div class="actions"><a class="button button-yellow" href={wa('Hello Oasis Necta, I want to start beekeeping')} target="_blank" rel="noreferrer">Start a conversation <span>↗</span></a><a class="text-link light" href="#contract">See how it works <span>↓</span></a></div>
        </div>
        <div class="hero-note"><span>01</span><span>Oasis Necta Ltd</span><span>Nairobi, Kenya</span></div>
      </section>

      <section class="promise-strip"><div class="container promise-grid"><div><span class="promise-number">01</span><strong>Free training</strong></div><div><span class="promise-number">02</span><strong>Technical support</strong></div><div><span class="promise-number">03</span><strong>Free county delivery</strong></div><div><span class="promise-number">04</span><strong>Ready market</strong></div></div></section>

      <section class="section container intro-section">
        <div class="section-kicker">01 / The Oasis Necta way</div><div class="intro-copy"><h2>A better beginning<br /><i>for every beekeeper.</i></h2><p>We believe beekeeping works best when the support is as dependable as the bees. Oasis Necta gives Kenyan beekeepers the tools, knowledge and market to build something lasting.</p><a class="text-link" href="#about">Our story <span>↗</span></a></div>
      </section>

      <section class="section container explore-section"><div class="section-heading"><div><div class="section-kicker">02 / Explore</div><h2>Everything you need<br /><i>to keep moving.</i></h2></div><p>From your first hive to your next harvest, find the right place to begin.</p></div><div class="explore-grid">{explore.map((card, i) => <a class:list={['explore-card', i === 0 ? 'feature-card' : '']} href={`#${card[0]}`}><div class="card-image"><img src={card[4]} alt="" loading="lazy" /><span>{card[1]}</span></div><div class="card-body"><h3>{card[2]}</h3><p>{card[3]}</p><span class="card-arrow">Explore <b>↗</b></span></div></a>)}</div></section>

      <section class="dark-section" id="contract"><div class="container contract-layout"><div class="section-kicker light">03 / Contract beekeeping</div><div><p class="eyebrow light">A clear path from hive to harvest</p><h2>Keep the bees.<br /><i>We’ll help you grow.</i></h2><p class="large-copy">When you buy hives from Oasis Necta, you join our contract beekeeping programme. You keep the bees. We make sure you are trained, supported and paid.</p><div class="actions"><a class="button button-yellow" href={wa('Hello Oasis Necta, I want to join contract beekeeping')} target="_blank" rel="noreferrer">Join the programme <span>↗</span></a><a class="text-link light" href="/documents/oasis-necta-beekeeping-contract.pdf" target="_blank" rel="noreferrer">Read the contract <span>↗</span></a></div></div></div><div class="container benefit-grid"><div><b>01</b><h3>Buy your hives</h3><p>Choose Langstroth or Kenya top bar hives and the equipment you need.</p></div><div><b>02</b><h3>Get trained</h3><p>Learn how to keep your bees and harvest properly.</p></div><div><b>03</b><h3>Stay supported</h3><p>Technical support continues while you produce.</p></div><div><b>04</b><h3>Get paid</h3><p>We buy your honey and bee products at set prices.</p></div></div></section>

      <section class="section container process-section"><div class="section-heading"><div><div class="section-kicker">04 / The process</div><h2>Simple steps.<br /><i>Steady progress.</i></h2></div><p>Contracted beekeepers know what happens next, from their first harvest to getting paid.</p></div><ol class="process-grid">{steps.map((step) => <li><span>{step[0]}</span><div class="step-icon">✳</div><h3>{step[1]}</h3><p>{step[2]}</p></li>)}</ol></section>

      <section class="honey-section" id="honey"><div class="container honey-layout"><div class="honey-image"><img src="/photos/p/p (6).jpeg" alt="Jars of Oasis Necta honey" loading="lazy" /></div><div class="honey-copy"><div class="section-kicker">05 / From our hives</div><h2>Good honey<br /><i>starts with care.</i></h2><p>Pure bee products from Oasis Necta. Ask us on WhatsApp for sizes, prices and what is in stock.</p><div class="buy-board">{buy.map((item) => <div><span>{item[0]}</span><b>{item[1]} <small>{item[2]}</small></b></div>)}</div><a class="button button-dark" href={wa('Hello Oasis Necta, I want to buy honey')} target="_blank" rel="noreferrer">Ask about availability <span>↗</span></a></div></div></section>

      <section class="section container shop-section" id="shop"><div class="section-heading"><div><div class="section-kicker">06 / Shop</div><h2>Build your<br /><i>beekeeping kit.</i></h2></div><p>Add what you need to your quote. When you’re ready, send it straight to our team on WhatsApp.</p></div><div class="catalog">{catalog.map((group) => <div class="catalog-group"><h3>{group.name}</h3>{group.items.map((item) => <div class="catalog-item"><span>{item[0]}</span><b>KES {item[1].toLocaleString('en-KE')}</b><div class="quantity" data-name={item[0]} data-price={item[1]}><button type="button" aria-label={`Remove one ${item[0]}`} data-change="-1">−</button><output>0</output><button type="button" aria-label={`Add one ${item[0]}`} data-change="1">+</button></div></div>)}</div>)}</div><div class="quote-bar" aria-live="polite"><strong class="quote-total">0 items · KES 0</strong><a class="button button-yellow send-quote" href={wa('Hello Oasis Necta, I would like a quote')} target="_blank" rel="noreferrer">Send quote on WhatsApp <span>↗</span></a></div><p class="fine-print">All prices in KES, VAT inclusive, and subject to change without notice. Listed as of October 2026.</p></section>

      <section class="section container about-section" id="about"><div class="about-image"><img src="/images/banner-about.jpg" alt="Beekeeping work in the field" loading="lazy" /></div><div class="about-copy"><div class="section-kicker">07 / About Oasis Necta</div><h2>Rooted in Kenya.<br /><i>Focused on people.</i></h2><p>Oasis Necta Ltd is a beekeeping company based in Nairobi. We offer contract beekeeping, technical support and training, and we give Kenyan beekeepers a market for their honey and bee products.</p><div class="about-details"><div><b>Our base</b><span>City Square, Nairobi</span></div><div><b>Our focus</b><span>People, bees & quality</span></div></div><div class="actions"><a class="button button-dark" href="https://www.facebook.com/profile.php?id=61582195871911" target="_blank" rel="noreferrer">Follow on Facebook <span>↗</span></a><a class="text-link" href="https://www.tiktok.com/@oasisnecta" target="_blank" rel="noreferrer">TikTok <span>↗</span></a></div></div></section>

      <section class="section gallery-section container"><div class="section-heading"><div><div class="section-kicker">08 / In the field</div><h2>Work that<br /><i>looks like this.</i></h2></div><p>Training days, apiary visits and the people who keep Oasis Necta moving.</p></div><div class="gallery-grid">{gallery.map((item) => <button class="gallery-tile" type="button" data-full={`/photos/${item[0]}`} data-alt={item[1]}><img src={`/photos/${item[0]}`} alt={item[1]} loading="lazy" /></button>)}</div></section>

      <section class="contact-section" id="contact"><div class="container contact-layout"><div><div class="section-kicker light">09 / Contact</div><h2>Let’s grow<br /><i>something good.</i></h2><p>Have questions or want to learn more? We’re here to help you take the next step.</p><div class="contact-links"><a href="tel:+254726897456"><small>Call or WhatsApp</small><strong>0726 897456 ↗</strong></a><a href="mailto:oasisnectaltd1@gmail.com"><small>Email</small><strong>oasisnectaltd1@gmail.com ↗</strong></a><div><small>Postal address</small><strong>P.O. Box 8946 – 00200<br />City Square, Nairobi, Kenya</strong></div></div></div><div class="contact-card"><p class="eyebrow">Message us on WhatsApp</p><label for="name">Your name</label><input id="name" autocomplete="name" placeholder="Your name" /><label for="message">Your message</label><textarea id="message" rows="4" placeholder="How can we help?"></textarea><button class="button button-yellow" type="button" id="contact-send">Open WhatsApp <span>↗</span></button></div></div></section>
      <div class="map-wrap"><iframe title="Map showing City Square, Nairobi" src="https://www.google.com/maps?q=City%20Square%2C%20Nairobi%2C%20Kenya&output=embed" loading="lazy"></iframe></div>
    </main>

    <footer><div class="container footer-grid"><div class="footer-brand"><img src="/images/logo.png" alt="" /><span>Oasis<br /><em>Necta</em></span><p>Pure bee products. Contract beekeeping, hives, training and a ready market for Kenyan beekeepers.</p></div><div><h3>Explore</h3><a href="#contract">Contract beekeeping</a><a href="#honey">Honey</a><a href="#shop">Hives & equipment</a><a href="#about">About & team</a></div><div><h3>Reach us</h3><a href="tel:+254726897456">0726 897456</a><a href="mailto:oasisnectaltd1@gmail.com">oasisnectaltd1@gmail.com</a><span>City Square, Nairobi</span></div><div><h3>Follow us</h3><a href="https://www.facebook.com/profile.php?id=61582195871911">Facebook ↗</a><a href="https://www.tiktok.com/@oasisnecta">TikTok ↗</a></div></div><div class="container footer-base"><span>© 2026 Oasis Necta Ltd. All rights reserved.</span><span>Built for a better harvest.</span></div></footer>
    <div class="lightbox" hidden><button class="lightbox-close" type="button" aria-label="Close image viewer">×</button><img src="" alt="" /></div>
    <script>
      const WA = '254726897456'; const wa = (text) => `https://wa.me/${WA}?text=${encodeURIComponent(text)}`;
      const menu = document.querySelector('.menu-toggle'), nav = document.querySelector('#main-nav');
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!open)); nav.classList.toggle('open', !open); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); }));
      const quantities = new Map(); const quote = document.querySelector('.quote-total'); const quoteLink = document.querySelector('.send-quote');
      function renderQuote() { let count = 0, total = 0, lines = []; quantities.forEach((value, name) => { if (value) { const el = document.querySelector(`[data-name="${CSS.escape(name)}"]`); const price = Number(el.dataset.price); count += value; total += value * price; lines.push(`${value} x ${name} (KES ${(value * price).toLocaleString('en-KE')})`); } }); quote.textContent = `${count} ${count === 1 ? 'item' : 'items'} · KES ${total.toLocaleString('en-KE')}`; quoteLink.href = wa(`Hello Oasis Necta, I would like a quote for:\n${lines.join('\n')}\nTotal: KES ${total.toLocaleString('en-KE')}`); }
      document.querySelectorAll('[data-change]').forEach((button) => button.addEventListener('click', () => { const wrap = button.closest('.quantity'), name = wrap.dataset.name, next = Math.max(0, (quantities.get(name) || 0) + Number(button.dataset.change)); quantities.set(name, next); wrap.querySelector('output').textContent = next; renderQuote(); }));
      document.querySelector('#contact-send')?.addEventListener('click', () => { const name = document.querySelector('#name').value.trim(), message = document.querySelector('#message').value.trim() || 'I have a question.'; window.open(wa(`Hello Oasis Necta. ${message}${name ? ` – ${name}` : ''}`), '_blank'); });
      const lightbox = document.querySelector('.lightbox'), lightboxImage = lightbox.querySelector('img'); document.querySelectorAll('.gallery-tile').forEach((tile) => tile.addEventListener('click', () => { lightboxImage.src = tile.dataset.full; lightboxImage.alt = tile.dataset.alt; lightbox.hidden = false; document.body.classList.add('no-scroll'); })); document.querySelector('.lightbox-close').addEventListener('click', () => { lightbox.hidden = true; document.body.classList.remove('no-scroll'); }); lightbox.addEventListener('click', (e) => { if (e.target === lightbox) { lightbox.hidden = true; document.body.classList.remove('no-scroll'); } });
    </script>
  </body>
</html>
